# development | production
APP_ENV=development
DATABASE_URL=sqlite:///./thumbnail_suite.db
STORAGE_DIR=./storage

# ollama | openai | bedrock | studio  (development default: ollama; production: openai or bedrock, required)
TEXT_PROVIDER=
# openai | bedrock | compositor  (development default: openai if OPENAI_API_KEY is set, else compositor; production: openai or bedrock, required)
IMAGE_PROVIDER=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-2
# low | medium | high  (default: low in development, high in production)
OPENAI_IMAGE_QUALITY=

# AWS credentials come from the standard chain: AWS_PROFILE, AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, or an IAM role.
AWS_REGION=us-west-2
# A Bedrock model or inference profile ID available in your account and region.
BEDROCK_TEXT_MODEL=
# Default: stability.stable-image-core-v1:1 in development, stability.stable-image-ultra-v1:1 in production
BEDROCK_IMAGE_MODEL=
