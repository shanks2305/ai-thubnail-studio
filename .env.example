# development | production
APP_ENV=development
DATABASE_URL=sqlite:///./thumbnail_suite.db
STORAGE_DIR=./storage

# Each agent role has its own provider. In development, blank means local:
# chat and judge use Ollama, images use the compositor.
# In production all three are required and must be openai or bedrock.
# chat: ollama | openai | bedrock | studio   (writes briefs, hooks, concepts, design specs)
CHAT_PROVIDER=
# judge: ollama | openai | bedrock | studio  (vision model that scores the thumbnail; studio = pixel checks only)
JUDGE_PROVIDER=
# image: ollama | openai | bedrock | compositor
IMAGE_PROVIDER=

# local | s3
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
# When set, every API call needs Authorization: Bearer <token>.
AUTH_TOKEN=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
# Must be a vision model, e.g. qwen2.5vl or llama3.2-vision.
OLLAMA_JUDGE_MODEL=qwen2.5vl
# Experimental, macOS only. The 4B model is Apache 2.0; the 9B model is non-commercial.
OLLAMA_IMAGE_MODEL=x/flux2-klein:4b

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-2
# low | medium | high  (default: low in development, high in production)
OPENAI_IMAGE_QUALITY=
# Optional. When set, the researcher saves popular thumbnails for the same game or live stream.
YOUTUBE_API_KEY=

# AWS credentials come from the standard chain: AWS_PROFILE, AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, or an IAM role.
AWS_REGION=us-west-2
# Bedrock model or inference profile IDs available in your account and region.
BEDROCK_CHAT_MODEL=
# Must accept images. Default: BEDROCK_CHAT_MODEL
BEDROCK_JUDGE_MODEL=
# Default: stability.stable-image-core-v1:1 in development, stability.stable-image-ultra-v1:1 in production
BEDROCK_IMAGE_MODEL=
